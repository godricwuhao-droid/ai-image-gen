# 公网部署环境变量配置
# 复制此文件为 .env 并填入实际值

# ========== 公网地址（部署时必填） ==========
# 图片访问的公网地址，前端通过此 URL 加载图片
MINIO_PUBLIC_URL=http://yourdomain.com/files

# ========== 安全密钥（生产环境必须修改） ==========
# JWT 密钥，改为随机强密码
SECRET_KEY=your-secret-key-change-this-in-production

# MinIO 密钥
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ========== API 密钥 ==========
OPENAI_API_KEY=sk-your-api-key-here
RELAY_API_KEY=sk-your-api-key-here
RELAY_API_BASE_URL=https://api.jiekou.ai
